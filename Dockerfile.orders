FROM node:20-alpine AS builder

WORKDIR /app

# Copy shared files first
COPY tsconfig.base.json ./

# Copy service-specific files
COPY backend/orders/package*.json ./backend/orders/
COPY backend/orders/tsconfig.json ./backend/orders/
COPY backend/orders/nest-cli.json ./backend/orders/

# Install dependencies
WORKDIR /app/backend/orders
RUN npm ci

# Copy source code
COPY backend/orders/src ./src

# Build
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Copy package files and install production deps
COPY backend/orders/package*.json ./
RUN npm ci --only=production

# Copy built application
COPY --from=builder /app/backend/orders/dist ./dist

# Add runtime path resolver
RUN npm install module-alias

EXPOSE 3001

CMD ["node", "-r", "module-alias/register", "dist/backend/orders/src/main.js"]
