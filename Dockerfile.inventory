FROM node:20-alpine AS builder

WORKDIR /app

# Copy shared files first
COPY tsconfig.base.json ./

# Copy service-specific files
COPY backend-nestjs/inventory/package*.json ./backend-nestjs/inventory/
COPY backend-nestjs/inventory/tsconfig.json ./backend-nestjs/inventory/
COPY backend-nestjs/inventory/nest-cli.json ./backend-nestjs/inventory/

# Install dependencies
WORKDIR /app/backend-nestjs/inventory
RUN npm ci

# Copy Prisma files AND config
COPY backend-nestjs/inventory/prisma ./prisma
COPY backend-nestjs/inventory/prisma.config.ts ./prisma.config.ts

# Generate Prisma Client
RUN npx prisma generate

# Copy source code
COPY backend-nestjs/inventory/src ./src

# Copy entrypoint script
COPY backend-nestjs/inventory/docker-entrypoint.sh ./docker-entrypoint.sh

# Build
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

COPY backend-nestjs/inventory/package*.json ./

# Copy Prisma files
COPY backend-nestjs/inventory/prisma ./prisma
COPY backend-nestjs/inventory/prisma.config.ts ./prisma.config.ts

RUN npm ci --only=production && \
    npx prisma generate

COPY --from=builder /app/backend-nestjs/inventory/dist ./dist
COPY --from=builder /app/backend-nestjs/inventory/docker-entrypoint.sh /app/docker-entrypoint.sh

RUN npm install module-alias && \
    chmod +x /app/docker-entrypoint.sh

EXPOSE 3002

ENTRYPOINT ["/app/docker-entrypoint.sh"]
