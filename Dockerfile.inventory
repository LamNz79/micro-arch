FROM node:20-alpine AS builder

WORKDIR /app

# Copy shared files first
COPY tsconfig.base.json ./
COPY contracts ./contracts

# Copy service-specific files
COPY backend-inventory/package*.json ./backend-inventory/
COPY backend-inventory/tsconfig.json ./backend-inventory/
COPY backend-inventory/nest-cli.json ./backend-inventory/

# Install dependencies
WORKDIR /app/backend-inventory
RUN npm ci

# Copy source code
COPY backend-inventory/src ./src

# Build
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

COPY backend-inventory/package*.json ./
RUN npm ci --only=production

COPY --from=builder /app/backend-inventory/dist ./dist
COPY --from=builder /app/contracts ../contracts

RUN npm install module-alias

EXPOSE 3002

CMD ["node", "-r", "module-alias/register", "dist/backend-inventory/src/main.js"]
